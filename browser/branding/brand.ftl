# Camio Browser brand strings (Fluent). Overwrites LibreWolf's
# browser/branding/librewolf/locales/en-US/brand.ftl in the source tree so the
# COMPILED browser reports "Camio Browser" natively — in the About dialog,
# window title, menus, and notifications — not just in a post-package rename.
#
# A Firefox-family build resolves every `-brand-*` term from this file, so
# changing them here is what actually rebrands the binary.

-brand-shorter-name = Camio
-brand-short-name = Camio Browser
-brand-full-name = Camio Browser
-brand-product-name = Camio Browser
-vendor-short-name = Camio
trademarkInfo = { "" }
